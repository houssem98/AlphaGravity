# market-ui deploys from repo root (project rootDirectory=apps/market-ui).
# Anchored with / — bare names match at any depth (killed src/services once).
node_modules
.git
/AionUi
/ponytail
/graphify-out
/docs
/infra
/scripts
/services
/packages
/apps/gravity-ui
/apps/market-ui/dist
/apps/market-ui/eval
/apps/market-ui/scripts
# Cloned third-party repos + the hyperresearch venv living in the repo root.
# None are build inputs; together they blew past Vercel's 15k-file upload cap
# (16,576 received) and made every deploy need --archive=tgz.
/TradingAgents-main
/personal-website
/FinceptTerminal-main
/financial-services-main
/.venv-hr
/.venv
/caveman
/.hyperresearch
/research
*.png
# ...but public/ is shipped assets, not stray screenshots — the bare *.png above
# matches at any depth and silently stripped the TN company logos from the build.
!/apps/market-ui/public/**
*.log
/entities.json
# CT2-3 · two GENERATED artifacts, each on its own past Vercel's 100 MB per-file
# cap, measured 2026-08-09 when the deploy died at "File size limit exceeded
# (100 MB)" after uploading 330.4 MB:
#   .codegraph/codegraph.db                       103.9 MB
#   apps/market-ui/test-results/commandTerminal-…  100.7 MB
# The second is this loop's OWN Playwright output — running the e2e gate broke
# the deploy gate. Neither is a build input.
/.codegraph
/apps/market-ui/test-results

{
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "regions": ["fra1"],
  "rewrites": [
    { "source": "/api/((?!tn/|agent/).*)", "destination": "https://market-server-prod.fly.dev/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/tn/snapshot", "schedule": "0 14 * * *" }
  ]
}
